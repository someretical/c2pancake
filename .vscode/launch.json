{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Debug c2pancake with current file",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.getLaunchTargetPath}",
            "args": [
                "--end=RewriteFunctionCalling",
                "${file}",
                "--",
                // "--target=aarch64-linux-gnu",
                "-std=c23",
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "type": "lldb-dap",
            "request": "launch",
            "name": "(lldb) Debug c2pancake with uart.c",
            "program": "${command:cmake.getLaunchTargetPath}",
            "env": {
                "LSAN_OPTIONS": "verbosity=1:log_threads=1"
            },
            "args": [
                "/home/one/sddf/drivers/serial/imx/uart.c",
                "--max-pass-retries=20",
                // "--end=RewriteFunctionCalling",
                "--",
                "-ffreestanding",
                "--target=aarch64-linux-gnu",
                "-mstrict-align",
                "-mcpu=cortex-a53",
                "-mtune=cortex-a53",
                "-I/home/one/microkit_tutorial/microkit-sdk-2.2.0/board/maaxboard/debug/include",
                "-I/home/one/sddf/examples/serial/include",
                "-I/home/one/sddf/include",
                "-I/home/one/sddf/include/microkit",
                "-I/home/one/sddf/include/sddf/util/custom_libc",
                "-I/home/one/sddf/drivers/serial/imx/include",
                "-I/usr/lib/gcc-cross/aarch64-linux-gnu/13/include",
            ],
            "cwd": "${workspaceFolder}",
            "sourceMap": {
                "/scratch/yankai/c2pancake": "${workspaceFolder}"
            },
            "console": "integratedTerminal",
        }
    ]
}