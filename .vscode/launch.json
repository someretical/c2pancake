{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb-dap",
            "request": "launch",
            "name": "Debug c2pancake with current file",
            "program": "${command:cmake.getLaunchTargetPath}",
            "args": [
                "--end=RewriteFunctionCalling",
                "${file}",
                "--",
                // "--target=aarch64-linux-gnu",
                "-std=c23",
            ],
            "cwd": "${workspaceFolder}",
            "sourceMap": {
                "/scratch/yankai/c2pancake": "${workspaceFolder}"
            },
            "console": "integratedTerminal",
        },
        {
            "type": "lldb-dap",
            "request": "launch",
            "name": "Debug c2pancake with uart.c",
            "program": "${command:cmake.getLaunchTargetPath}",
            "args": [
                "/home/one/sddf/drivers/serial/imx/uart.c",
                "--",
                "-ffreestanding",
                "--target=aarch64-linux-gnu",
                "-mstrict-align",
                "-mcpu=cortex-a53",
                "-mtune=cortex-a53",
                "-I/home/one/microkit_tutorial/microkit-sdk-2.2.0/board/maaxboard/debug/include",
                "-I/home/one/sddf/examples/serial/include",
                "-I/home/one/sddf/include",
                "-I/home/one/sddf/include/microkit",
                "-I/home/one/sddf/include/sddf/util/custom_libc",
                "-I/home/one/sddf/drivers/serial/imx/include",
                "-I/usr/lib/gcc-cross/aarch64-linux-gnu/13/include",
            ],
            "cwd": "${workspaceFolder}",
            "sourceMap": {
                "/scratch/yankai/c2pancake": "${workspaceFolder}"
            },
            "console": "integratedTerminal",
        }
    ]
}