{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Debug c2pancake with current file",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.getLaunchTargetPath}",
            "args": [
                // "--start=C2Pancake",
                "${file}",
                "--skip",
                "ConvertIntegerTypes",
                "--",
                // "--target=aarch64-linux-gnu",
                "-std=c23",
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "sourceFileMap": {
                "/scratch/yankai/c2pancake": "${workspaceFolder}"
            },
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "(gdb) Debug c2pancake with uart.c",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.getLaunchTargetPath}",
            "args": [
                "/home/tor/sDDF/drivers/serial/imx/uart2.c",
                "--max-pass-retries=20",
                "--function-rewrite-extra-headers=#include \\\"uart2.h\\\"",
                // "--end=RewriteFunctionCalling",
                "--skip=ConvertIntegerTypes",
                "--",
                "-DNDEBUG",
                "-ffreestanding",
                "--target=aarch64-linux-gnu",
                "-mstrict-align",
                "-mcpu=cortex-a53",
                "-mtune=cortex-a53",
                "-I/home/tor/microkit/board/maaxboard/debug/include",
                "-I/home/tor/sDDF/examples/serial/include",
                "-I/home/tor/sDDF/include",
                "-I/home/tor/sDDF/include/microkit",
                "-I/home/tor/sDDF/include/sddf/util/custom_libc",
                "-I/home/tor/sDDF/drivers/serial/imx/include",
                "-I/usr/lib/gcc-cross/aarch64-linux-gnu/13/include",
            ],
            "cwd": "${workspaceFolder}",
            "sourceFileMap": {
                "/scratch/yankai/c2pancake": "${workspaceFolder}"
            },
        }
    ]
}